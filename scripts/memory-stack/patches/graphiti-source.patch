+    base_url = settings.llm_base_url or settings.openai_base_url
+    model = settings.llm_model_name or settings.model_name
+    config = LLMConfig(api_key=api_key, base_url=base_url, model=model)
+    return OpenAIClient(config=config, reasoning='medium', verbosity='low')
