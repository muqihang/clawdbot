+_GROUP_ID_SANITIZER = re.compile(r'[^a-zA-Z0-9_-]+')
+_DEFAULT_SEARCH_GROUP_IDS = [
+    'openclaw-backfill-canonical',
+    'openclaw-backfill-topics',
+    'openclaw-backfill-daily',
+    'agent_main_main',
+]
+
+
+def normalize_group_id(group_id: str | None) -> str | None:
+    if not group_id:
+        return None
+    normalized = _GROUP_ID_SANITIZER.sub('_', group_id).strip('_')
+    return normalized or 'default'
+
+
+def normalize_group_ids(group_ids: list[str] | None) -> list[str] | None:
+    if not group_ids:
+        return None
+
+    deduped: list[str] = []
+    seen: set[str] = set()
+    for group_id in group_ids:
+        normalized = normalize_group_id(group_id)
+        if not normalized or normalized in seen:
+            continue
+        seen.add(normalized)
+        deduped.append(normalized)
+
+    return deduped or None
+
 
