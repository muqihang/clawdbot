{
  "memory_backend": "qmd",
  "memory_qmd": {
    "searchMode": "search",
    "includeDefaultMemory": true,
    "limits": {
      "maxResults": 6,
      "timeoutMs": 30000
    },
    "update": {
      "interval": "15m",
      "debounceMs": 15000,
      "waitForBootSync": false,
      "embedInterval": "180m",
      "updateTimeoutMs": 180000,
      "embedTimeoutMs": 180000
    },
    "paths": [
      {
        "path": "/Users/muqihang/chelingxi_workspace/clawdbot/analysis",
        "name": "jarvis-analysis",
        "pattern": "**/*.md"
      },
      {
        "path": "/Users/muqihang/chelingxi_workspace/clawdbot/docs",
        "name": "clawdbot-docs",
        "pattern": "**/*.md"
      }
    ]
  },
  "plugins_slots": {
    "memory": "memory-mem0-graphiti-bridge"
  },
  "bridge": {
    "read_mode": "primary",
    "write_mode": "propose_only",
    "cutover_percent": 100,
    "request_timeout_ms": 3000,
    "routing": {
      "default_route": "local",
      "timeline_route": "graphiti",
      "semantic_route": "mem0",
      "fallback_route": "local"
    },
    "timeoutMs": {
      "search": 3000,
      "get": 3000
    },
    "mem0_base_url": "http://127.0.0.1:8766",
    "graphiti_base_url": "http://127.0.0.1:8000"
  }
}
